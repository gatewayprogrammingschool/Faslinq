<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net6.0;net5.0;netstandard2.1;netstandard2.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>10.0</LangVersion>
        <DebugType>embedded</DebugType>
        <Configurations>Debug;Release;Benchmarks</Configurations>
        <Platforms>AnyCPU;x64</Platforms>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <Copyright>©️ 2021 - Gateway Programming School, Inc.</Copyright>
        <PackageProjectUrl>https://github.com/gatewayprogrammingschool/Faslinq</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/gatewayprogrammingschool/Faslinq</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>LINQ</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <!--
      Debug and Release use the SDK defaults: Debug defines DEBUG;TRACE unoptimized, Release defines TRACE optimized.
      PlatformTarget is left to the SDK so AnyCPU builds, and so the NuGet package, stay platform-neutral.
    -->
    <PropertyGroup Condition="'$(Configuration)' == 'Benchmarks'">
      <Optimize>True</Optimize>
    </PropertyGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Faslinq.Tests" />
    </ItemGroup>

    <ItemGroup>
      <None Include="..\README.md">
        <Pack>True</Pack>
        <PackagePath></PackagePath>
      </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="GitVersion.MsBuild" Version="5.7.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Netstandard20.Range.Bridge" Version="1.0.0" Condition="'$(TargetFramework)'=='netstandard2.0'" />
    </ItemGroup>
</Project>
